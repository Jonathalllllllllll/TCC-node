<!DOCTYPE html>
<html lang="pt-br">

<head>
    <%- include('../partials/head'); %>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #94b6da;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        header {
            width: 100%;
        }

        .menu-topo {
            margin-top: 20px;
            font-family: Arial Black;
        }

        .menu-topo button {
            margin: 0 10px;
            padding: 10px 20px;
            background-color: #143d8a;
            color: white;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
        }

        .menu-topo button:hover {
            background-color: #143d8a;
        }

        main {
            text-align: center;
            margin-top: 40px;
        }

        main h2 {
            font-size: 32px;
            color: #143d8a;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .form-btn {
            padding: 15px 40px;
            background-color: #143d8a;
            color: white;
            font-weight: bold;
            font-size: 30px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }

        .form-btn:hover {
            background-color: #143d8a;
        }

        #main1 {
            position: relative;
            margin-top: 180px;
        }

        .body3 {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #titulo {
            font-family: impact;
            font-size: 70px;
        }
    </style>
</head>

<body>
    <header><%- include('../partials/menu_adm'); %></header>

    <div class="menu-topo">
        <button onclick="location.href='/adm/login/front_end'">Login</button>
        <button onclick="location.href='/adm/logout'">Log out</button>
        <button onclick="location.href='/adm/cadastro/front_end'">Fazer cadastro</button>
    </div>

    <div class="body3">
        <main id="main1">
            <h2 id="titulo">Olá administrador!<br>Seja bem-vindo ao site.</h2>
            <button class="form-btn" onclick="location.href='/adm/lista_comen_e_resposta'">Ver lista de comentários</button>
        </main>
    </div>
</body>

</html>
