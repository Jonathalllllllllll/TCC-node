<!DOCTYPE html>
<html lang="pt-br">

<head>
   <%- include('../partials/head'); %>
   <style>
      body {
         font-family: 'Poppins', sans-serif;
         margin: 0;
         padding: 0;
         background-color: #94b6da; 
         min-height: 100vh;
         display: flex;
         flex-direction: column;
      }

      main {
         flex: 1; 
         display: flex;
         justify-content: center;
         align-items: center;   
      }

      #formulario_login {
         background-color: white;
         border-radius: 10px;
         padding: 40px;
         width: 400px;
         box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      }

      h1 {
         color: #143d8a;
         font-size: 30px;
         font-weight: 700;
         font-family: arial black;
         text-align: center;
         margin-bottom: 30px;
      }

      .form-group {
         display: flex;
         flex-direction: column;
         margin-bottom: 20px;
      }

      label {
         font-weight: bold;
         margin-bottom: 5px;
         color: #143d8a;
      }

      input.form-control {
         border: 3px solid #143d8a;
         border-radius: 30px;
         padding: 10px 15px;
         font-size: 16px;
         outline: none;
      }

      button {
         width: 100%;
         background-color: #143d8a;
         color: white;
         font-weight: bold;
         font-size: 20px;
         padding: 12px;
         border: none;
         border-radius: 25px;
         box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
         transition: all 0.3s ease-in-out;
      }

      button:hover {
         background-color: #143d8a;
         transform: scale(1.05);
      }

      a {
         display: block;
         text-align: center;
         color: #143d8a;
         text-decoration: none;
      }

      a:hover {
         color: #143d8a;
      }

      @media screen and (max-width: 600px) {
         #formulario_login {
            width: 90%;
            padding: 20px;
         }

         h1 {
            font-size: 35px;
            font-family: Arial black
         }
      }
   </style>
</head>

<body>
   <header><%- include('../partials/menu_adm'); %></header>

   <main>
      <div id="formulario_login">
         <h1>Olá coordenador, realize seu login</h1>
         <form action="/adm/login/backend" method="POST">
            <div class="form-group">
               <label for="usr">Email</label>
               <input type="email" class="form-control" id="usr" name="email_adm" placeholder="Digite seu email" required>
            </div>
            <div class="form-group">
               <label for="pwd">Senha</label>
               <input type="password" class="form-control" id="pwd" name="senha_adm" placeholder="Digite sua senha" required>
            </div>
            <button type="submit">Login</button>
         </form>
         <a href="/adm/cadastro/front_end">Não possuo cadastro</a>
      </div>
   </main>

   <script>
      const params = new URLSearchParams(window.location.search);
      if (params.get('erro') === '1') {
        alert("Senha digitada incorretamente");
      }
    </script>

</body>


</html>
